# =============================================================================
# GreenTrip 환경변수 템플릿
# - 이 파일을 .env.local로 복사하여 실제 값을 채워 사용한다.
# - .env.local과 .env 는 git에 커밋되지 않는다 (.gitignore 확인).
# - NEXT_PUBLIC_ 접두사가 붙은 키만 클라이언트 번들에 노출되며, 그 외는 서버 전용.
# =============================================================================

# -----------------------------------------------------------------------------
# 한국관광공사 TourAPI (KorService1) — 서버 전용
# 발급: https://www.data.go.kr → "한국관광공사_국문관광정보서비스_GW"
# 활용 API 10종: areaCode1, categoryCode1, locationBasedList1, areaBasedList1,
#                searchKeyword1, searchFestival1, detailCommon1, detailIntro1,
#                detailImage1, detailPetTour1
# -----------------------------------------------------------------------------
TOUR_API_KEY=your_tour_api_service_key_here

# -----------------------------------------------------------------------------
# Kakao Maps & REST API
# 발급: https://developers.kakao.com
# - NEXT_PUBLIC_KAKAO_MAP_KEY: JavaScript Key (클라이언트 SDK 로드용, 공개 가능)
# - KAKAO_REST_API_KEY: REST API Key (서버에서 길찾기 등 호출 시, 서버 전용)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_javascript_key
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# -----------------------------------------------------------------------------
# Supabase (PostgreSQL)
# 발급: https://supabase.com → New Project → Settings → Database → Connection string
# - DATABASE_URL: Transaction pooler (port 6543) — Prisma 일반 쿼리용
# - DIRECT_URL:  Session/Direct (port 5432) — Prisma migrate dev 용
# 두 URL 모두 반드시 설정해야 마이그레이션이 정상 동작.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# -----------------------------------------------------------------------------
# Upstash Redis (TourAPI 응답 캐시)
# 발급: https://upstash.com → Create Database (Regional, ap-northeast-1 권장)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# -----------------------------------------------------------------------------
# NextAuth (Phase 2 W12 도입)
# - NEXTAUTH_SECRET 생성:
#     Linux/macOS:  openssl rand -base64 32
#     Windows PS:   [Convert]::ToBase64String((1..32 | %{[byte](Get-Random -Max 256)}))
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_32bytes_base64

# -----------------------------------------------------------------------------
# 소셜 로그인 (Phase 2 W12 — 카카오/네이버)
# -----------------------------------------------------------------------------
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# -----------------------------------------------------------------------------
# 모니터링 (Phase 3 W15, 선택)
# -----------------------------------------------------------------------------
SENTRY_DSN=your_sentry_dsn
